# Application Configuration
NODE_ENV=test
PORT=4001
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL Test DB)
DATABASE_URL=postgresql://vistora_user:vistora_password@localhost:5432/vistora_test_db?schema=public

# Redis Cache & Queues
REDIS_URL=redis://localhost:6379/1

# Authentication & Security
JWT_SECRET=test_jwt_access_secret_key_minimum_length_32_bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key_minimum_length_32_bytes
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4001/api/v1/auth/google/callback

# Cloudinary File Storage
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_mock_id
RAZORPAY_KEY_SECRET=test_razorpay_secret
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_secret

# Nodemailer Email Config
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test_user
SMTP_PASS=test_pass
EMAIL_FROM="Vistora Test <noreply@test.vistoracommerce.com>"
